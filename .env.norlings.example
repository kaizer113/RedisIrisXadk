# Norling's runs as a separate process while sharing the core Redis database.
EXPERIENCE_ID=norlings
DATASET_DIR=data/norlings/generated
STATIC_DIR=valuewholesale_agent/static
REDIS_KEY_PREFIX=norlings
REDIS_INDEX_PREFIX=idx:norlings
EMBEDDING_CACHE_NAME=norlings-embeddings-v1

# Google Cloud / Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_MEMORY_LOCATION=
GOOGLE_AGENT_ENGINE_ID=
GOOGLE_MODEL=gemini-3.1-flash-lite
GOOGLE_MODELS="gemini-3.1-flash-lite gemini-3.1-pro-preview"
ADK_APP_NAME=norlings-shopping-agent
ADK_GREETING_APP_NAME=norlings-greeting-agent
ADK_TRANSCRIPT_APP_NAME=norlings-working-memory
MEMORY_BANK_DISPLAY_NAME=norlings-memory-bank
VALUEWHOLESALE_VM_CONTAINER_NAME=norlings-agent
VALUEWHOLESALE_VM_HOST_PORT=8081

# Norling's demo identity
VALUEWHOLESALE_DEMO_MEMBER_ID=member-2001
VALUEWHOLESALE_DEMO_SESSION_ID=norlings-demo-1
VALUEWHOLESALE_VECTOR_SEARCH_ENABLED=true
VALUEWHOLESALE_EMBEDDING_MODEL=redis/langcache-embed-v3-small
VALUEWHOLESALE_EMBEDDING_DEVICE=cpu
VALUEWHOLESALE_EMBEDDING_CACHE_TTL_SECONDS=86400
VALUEWHOLESALE_TOOL_CACHE_TTL_SECONDS=43200
VALUEWHOLESALE_AGENT_TIMEOUT_SECONDS=90
VALUEWHOLESALE_WARMUP_ON_STARTUP=false

# Shared Redis Cloud database. Copy the same REDIS_URL used by Value Wholesale.
REDIS_URL=
VALUEWHOLESALE_SEMANTIC_ROUTER_THRESHOLD=0.48
VALUEWHOLESALE_SEMANTIC_ROUTER_INDEX=norlings-cache-router-v1

# Dedicated Norling's Context Surface and agent key
CTX_ADMIN_KEY=
CTX_MCP_URL=https://gcp-us-east4.context-surfaces.redis.io/mcp
CTX_SURFACE_ID=
MCP_AGENT_KEY=
CONTEXT_SURFACE_NAME="Norling's Shopping"
CONTEXT_AGENT_NAME=norlings-adk-shopping-agent
CONTEXT_AGENT_DISPLAY_NAME="Public Norling's shopping agent"

# Dedicated Norling's LangCache
LANGCACHE_HOST=https://gcp-us-east4.langcache.redis.io
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=
LANGCACHE_SIMILARITY_THRESHOLD=0.80
LANGCACHE_HTTP_KEEPALIVE_SECONDS=300

# Dedicated Norling's Redis Agent Memory store
AGENT_MEMORY_BASE_URL=https://gcp-us-east4.memory.redis.io
AGENT_MEMORY_STORE_ID=
AGENT_MEMORY_API_KEY=
AGENT_MEMORY_NAMESPACE=norlings-shopping
AGENT_MEMORY_SIMILARITY_THRESHOLD=0.30
AGENT_MEMORY_HTTP_KEEPALIVE_SECONDS=300

PORT=8081
LOG_LEVEL=INFO
