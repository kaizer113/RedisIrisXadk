# Only the new port 8083 runtime reads this file. Never copy it over other demo .env files.
# Fill actual GA endpoints and scoped agent keys after suite provisioning.
REDIS_URL=
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=8
REDIS_STREAM_MAX_RUN=3600
REDIS_STREAM_DONE_TTL=3600
ONPREM_NAMESPACE=valuewholesale-onprem-ga
# Generate once; use the same random value on every worker/redeploy (at least 32 characters).
ONPREM_SESSION_SECRET=
ONPREM_COOKIE_SECURE=false
ONPREM_RUN_TTL=86400
ONPREM_TURN_TIMEOUT=120
ONPREM_MAX_TOOL_ROUNDS=6

GOOGLE_CLOUD_PROJECT=central-beach-194106
GOOGLE_CLOUD_LOCATION=global
GOOGLE_MODEL=gemini-3.6-flash

IRIS_AGENT_MEMORY_URL=
IRIS_AGENT_MEMORY_STORE_ID=
IRIS_AGENT_MEMORY_API_KEY=
# Actual namespace ID created by the GA Memory service, not the old namespace label.
IRIS_AGENT_MEMORY_NAMESPACE_ID=
IRIS_AGENT_PLAYBOOKS_URL=
IRIS_AGENT_PLAYBOOKS_PLAYBOOK_ID=
IRIS_AGENT_PLAYBOOKS_API_KEY=
IRIS_INTENT_ROUTER_URL=
IRIS_INTENT_ROUTER_ID=
IRIS_INTENT_ROUTER_API_KEY=
# Full Gateway MCP URL, ending /iris/data/v1/context-gateway/gateways/<id>/mcp.
IRIS_CONTEXT_GATEWAY_URL=
IRIS_CONTEXT_GATEWAY_API_KEY=
IRIS_LENS_ENDPOINT=
IRIS_LENS_API_KEY=
IRIS_LENS_AGENT_ID=valuewholesale-onprem
IRIS_LENS_CAPTURE_CONTENT=false
