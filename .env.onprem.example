# Exact Value Wholesale copy backed by self-managed Iris services.
EXPERIENCE_ID=valuewholesale
DATASET_DIR=data/generated
STATIC_DIR=valuewholesale_agent/static
REDIS_KEY_PREFIX=valuewholesale-onprem
REDIS_INDEX_PREFIX=idx:valuewholesale-onprem
EMBEDDING_CACHE_NAME=valuewholesale-onprem-embeddings-v1

# Keep the same Google ADK / Vertex settings as the original Value Wholesale demo.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_MEMORY_LOCATION=
GOOGLE_AGENT_ENGINE_ID=
GOOGLE_MODEL=gemini-3.1-flash-lite
GOOGLE_MODELS="gemini-3.1-flash-lite gemini-3.1-pro-preview"
VALUEWHOLESALE_DEMO_MEMBER_ID=member-1001
VALUEWHOLESALE_DEMO_SESSION_ID=valuewholesale-onprem-demo-1
VALUEWHOLESALE_VECTOR_SEARCH_ENABLED=true
VALUEWHOLESALE_EMBEDDING_MODEL=redis/langcache-embed-v3-small
VALUEWHOLESALE_EMBEDDING_DEVICE=cpu
VALUEWHOLESALE_EMBEDDING_CACHE_TTL_SECONDS=86400
VALUEWHOLESALE_TOOL_CACHE_TTL_SECONDS=43200
VALUEWHOLESALE_SEMANTIC_ROUTER_THRESHOLD=0.48
VALUEWHOLESALE_SEMANTIC_ROUTER_INDEX=valuewholesale-onprem-cache-router-v1
VALUEWHOLESALE_AGENT_TIMEOUT_SECONDS=90
VALUEWHOLESALE_WARMUP_ON_STARTUP=false

# Shared Redis database, isolated by the prefixes above.
REDIS_URL=

# Self-managed Context Retriever. CTX_API_URL is only needed by setup-context.
CTX_API_URL=http://10.42.0.9:8080
CTX_ADMIN_KEY=
CTX_MCP_URL=http://10.42.0.9:8081/mcp
CTX_SURFACE_ID=
MCP_AGENT_KEY=
CONTEXT_SURFACE_NAME="Value Wholesale Shopping On-Prem"
CONTEXT_AGENT_NAME=valuewholesale-onprem-adk-shopping-agent
CONTEXT_AGENT_DISPLAY_NAME="Value Wholesale agent using self-managed Iris"

# Self-managed LangCache.
LANGCACHE_HOST=http://10.42.0.9:9001
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=
LANGCACHE_SIMILARITY_THRESHOLD=0.80
LANGCACHE_HTTP_KEEPALIVE_SECONDS=300

# Self-managed Agent Memory. Authentication is disabled only for this private demo endpoint;
# the SDK still needs a non-empty configuration value to enable its adapter.
AGENT_MEMORY_BASE_URL=http://10.42.0.9:9000
AGENT_MEMORY_STORE_ID=
AGENT_MEMORY_API_KEY=onprem-no-auth
AGENT_MEMORY_NAMESPACE=valuewholesale-onprem-shopping
AGENT_MEMORY_SIMILARITY_THRESHOLD=0.30
AGENT_MEMORY_HTTP_KEEPALIVE_SECONDS=300

# Third container on the shared Compute Engine VM.
VALUEWHOLESALE_VM_CONTAINER_NAME=valuewholesale-onprem-agent
VALUEWHOLESALE_VM_HOST_PORT=8083
VALUEWHOLESALE_VM_FIREWALL_RULE=valuewholesale-onprem-allow-8083
VALUEWHOLESALE_VM_NETWORK=default
VALUEWHOLESALE_VM_SUBNETWORK=
VALUEWHOLESALE_VM_USE_IAP=false
VALUEWHOLESALE_VM_SSH_SOURCE_RANGES=
VALUEWHOLESALE_VM_OWNER_LABEL=lionel_giavelli
VALUEWHOLESALE_VM_SKIP_DELETION_LABEL=yes
VALUEWHOLESALE_VM_REDIS_HOST=

PORT=8083
LOG_LEVEL=INFO
